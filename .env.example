# .env.example — copy this file to .env.local and fill in the values
# ---------------------------------------------------------------------------
#   cp .env.example .env.local
#
# NEVER commit .env.local (it's in .gitignore). Share real keys in the team
# group chat, not in git. On Vercel, add the same values under
# Project → Settings → Environment Variables.
#
# EVERYTHING HERE IS OPTIONAL TO START:
#   - no Supabase vars → the app uses in-memory demo data (lib/db/memory.ts)
#   - no AI key        → AI features use rule-based fallbacks (lib/ai/fallback.ts)

# --- Database (Backend) ---------------------------------------------------
# Supabase dashboard → Project Settings → API
SUPABASE_URL=
# The "service_role" secret key. Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (AI lead) ---------------------------------------------------------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: which model to use (default: claude-sonnet-5-5)
AI_MODEL=

# --- App ------------------------------------------------------------------
# The public URL of the deployed site, used in share links.
# Leave empty locally; set it on Vercel to e.g. https://carry-osu.vercel.app
NEXT_PUBLIC_APP_URL=
