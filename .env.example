# Copy to .env.local (never committed) and fill in. On Vercel, set the same
# values under Settings > Environment Variables. All are optional:
#   - no Supabase vars: in-memory demo data (lib/db/memory.ts)
#   - no AI key: rule-based fallbacks (lib/ai/fallback.ts)

# Supabase dashboard → Project Settings → API
SUPABASE_URL=
# The "service_role" secret key. Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: which model to use (default: claude-sonnet-5-5)
AI_MODEL=
